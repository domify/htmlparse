# htmlparse in one call: *input* parsed as html5ever parses a fragment in
# `body`, and written back as its serializer writes it, on the tape.
#
#     tape { puts htmlparse(body) }
#
# `document: true` parses a whole document instead. For the tree itself,
# use `parse_fragment` or `parse_document` (htmlparse/parse).
module htmlparse

import htmlparse/parse::{parse_document, parse_fragment, Options}
import htmlparse/dom::{Namespace}
import htmlparse/serialize::{serialize_children, SerializeOptions}

pub def htmlparse(input : String, options : Options = Options.new, document : Bool = false,
                  serialize_options : SerializeOptions = SerializeOptions.new) : String
  result = ""
  if document
    parse_document(input, options) do |parsed|
      serialize_children(parsed.dom, parsed.root, result, serialize_options)
    end
  else
    parse_fragment(input, "body", Namespace::Html, options) do |parsed|
      serialize_children(parsed.dom, parsed.root, result, serialize_options)
    end
  end
  result
end
