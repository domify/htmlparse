# The tree a parse builds, on the tape: nodes in one array, linked by
# index (parent, first and last child, previous and next sibling), so
# that moving a node is a few writes and finding its place is none.
# Attributes are ranges of one array, the tokenizer's: a node whose
# attributes change gets a new range at its end.
#
# Text that the parser adds next to a text node joins it, as in the DOM.
# The pieces are kept apart until the text is read, so that text built
# from many tokens (`a&amp;b&amp;c…`) is joined once, not once per piece.
module htmlparse/dom

import std/int
import htmlparse/tags::{Tag, tag_of}
import htmlparse/tokenizer::{Attr}

pub enum NodeKind : UInt8
  Document
  Fragment
  Element
  Text
  Comment
  Doctype
end

# An element's namespace, and an attribute's (`None` for most).
pub enum Namespace : UInt8
  None
  Html
  Svg
  MathML
  XLink
  Xml
  Xmlns
end

NO_NODE = -1

# A node's kind and links: the numbers that change as the tree does. Its
# text lives in arrays of its own, so that writing a link back copies no
# view of the node array into itself.
pub struct Node
  property kind : NodeKind
  property namespace : Namespace
  # An element's name as a `Tag`; `Tag::Other` for a name the parser
  # does not decide by.
  property tag : Tag
  # Where in the tree's names this node's name is; 0, empty, if it has none.
  property name_index : Int32
  property parent : Int32
  property first_child : Int32
  property last_child : Int32
  property previous : Int32
  property next : Int32
  property attrs_start : Int32
  property attrs_count : Int32
  # A template element's contents, a fragment, when the parse keeps them
  # apart; otherwise its children are its contents. On that fragment, the
  # template: the way back up, as its `parent` is none.
  property contents : Int32
  # Text added to this text node since its data was last read, as a list
  # of pieces.
  property pieces_first : Int32
  property pieces_last : Int32
  # Where in the tree's joined text this node's data is, once joined.
  property joined_start : Int32
  property joined_size : Int32

  def initialize(@kind : NodeKind, @namespace : Namespace, @tag : Tag)
    @name_index = 0
    @parent = NO_NODE
    @first_child = NO_NODE
    @last_child = NO_NODE
    @previous = NO_NODE
    @next = NO_NODE
    @attrs_start = 0
    @attrs_count = 0
    @contents = NO_NODE
    @pieces_first = NO_NODE
    @pieces_last = NO_NODE
    @joined_start = NO_NODE
    @joined_size = 0
  end
end

@[OnTape]
struct Piece
  getter text : String
  property next : Int32

  def initialize(@text : String)
    @next = NO_NODE
  end
end

@[OnTape]
pub struct Dom
  getter nodes : Array(Node)
  getter attrs : Array(Attr)
  # Elements' local names and doctypes' names, shared by clones.
  @names : Array(String)
  # By node: a text's or comment's data, a doctype's public identifier.
  @datas : Array(String)
  # By node: a doctype's system identifier.
  @system_ids : Array(String)
  @pieces : Array(Piece)
  # Joined text, one stable buffer that views of it stay valid across.
  @joined : String::Builder
  @empty : String

  # A document node, 0, with *attrs* holding the attributes to come.
  def initialize(@attrs : Array(Attr), empty : String)
    @empty = empty
    document = Node.new(NodeKind::Document, Namespace::None, Tag::Other)
    @nodes = Array(Node).new(1, document)
    @names = Array(String).new(1, empty)
    @datas = Array(String).new(1, empty)
    @system_ids = Array(String).new(1, empty)
    @pieces = Array(Piece).new
    @joined = String::Builder.new(0)
  end

  def document : Int32
    0
  end

  def [](node : Int32) : Node
    @nodes[node]
  end

  def size : Int32
    @nodes.size
  end

  # --- making nodes -----------------------------------------------------

  private def add(node : Node, data : String, system_id : String) : Int32
    @nodes << node
    @datas << data
    @system_ids << system_id
    @nodes.size - 1
  end

  private def name_index(name : String) : Int32
    @names << name
    @names.size - 1
  end

  private def plain(kind : NodeKind) : Node
    Node.new(kind, Namespace::None, Tag::Other)
  end

  def create_fragment : Int32
    add(plain(NodeKind::Fragment), @empty, @empty)
  end

  # An element with the `count` attributes from `start` in `attrs`.
  def create_element(namespace : Namespace, name : String, start : Int32, count : Int32) : Int32
    create_element(namespace, name, tag_of(name), start, count)
  end

  def create_element(namespace : Namespace, name : String, tag : Tag, start : Int32, count : Int32) : Int32
    node = Node.new(NodeKind::Element, namespace, tag)
    node.attrs_start = start
    node.attrs_count = count
    node.name_index = name_index(name)
    add(node, @empty, @empty)
  end

  # A new HTML element named as *like* is, with the `count` attributes
  # from `start` in `attrs`.
  def clone_element(like : Int32, tag : Tag, start : Int32, count : Int32) : Int32
    node = Node.new(NodeKind::Element, Namespace::Html, tag)
    node.attrs_start = start
    node.attrs_count = count
    node.name_index = @nodes[like].name_index
    add(node, @empty, @empty)
  end

  def create_text(text : String) : Int32
    add(plain(NodeKind::Text), text, @empty)
  end

  def create_comment(text : String) : Int32
    add(plain(NodeKind::Comment), text, @empty)
  end

  def create_doctype(name : String, public_id : String, system_id : String) : Int32
    node = plain(NodeKind::Doctype)
    node.name_index = name_index(name)
    add(node, public_id, system_id)
  end

  def set_contents(node : Int32, fragment : Int32) : Nil
    entry = @nodes[node]
    entry.contents = fragment
    @nodes[node] = entry
    owned = @nodes[fragment]
    owned.contents = node
    @nodes[fragment] = owned
  end

  # --- reading ----------------------------------------------------------

  def kind(node : Int32) : NodeKind
    @nodes[node].kind
  end

  def parent(node : Int32) : Int32
    @nodes[node].parent
  end

  def first_child(node : Int32) : Int32
    @nodes[node].first_child
  end

  def last_child(node : Int32) : Int32
    @nodes[node].last_child
  end

  def next_sibling(node : Int32) : Int32
    @nodes[node].next
  end

  def previous_sibling(node : Int32) : Int32
    @nodes[node].previous
  end

  def tag(node : Int32) : Tag
    @nodes[node].tag
  end

  def namespace(node : Int32) : Namespace
    @nodes[node].namespace
  end

  def name(node : Int32) : String
    @names[@nodes[node].name_index]
  end

  def element?(node : Int32) : Bool
    @nodes[node].kind == NodeKind::Element
  end

  def text?(node : Int32) : Bool
    @nodes[node].kind == NodeKind::Text
  end

  # Whether *node* is the HTML element *tag*.
  def html?(node : Int32, tag : Tag) : Bool
    entry = @nodes[node]
    entry.tag == tag && entry.namespace == Namespace::Html && entry.kind == NodeKind::Element
  end

  def contents(node : Int32) : Int32
    return NO_NODE if @nodes[node].kind == NodeKind::Fragment
    @nodes[node].contents
  end

  # The template whose contents the fragment *node* is; NO_NODE for any
  # other node.
  def contents_owner(node : Int32) : Int32
    return NO_NODE unless @nodes[node].kind == NodeKind::Fragment
    @nodes[node].contents
  end

  def attrs_start(node : Int32) : Int32
    @nodes[node].attrs_start
  end

  def attrs_count(node : Int32) : Int32
    @nodes[node].attrs_count
  end

  def attr(node : Int32, index : Int32) : Attr
    @attrs[@nodes[node].attrs_start + index]
  end

  # A text's or comment's data; a text's pieces joined first.
  def data(node : Int32) : String
    entry = @nodes[node]
    if entry.pieces_first != NO_NODE
      start = @joined.length
      @joined.append(stored_data(node))
      piece = entry.pieces_first
      while piece != NO_NODE
        @joined.append(@pieces[piece].text)
        piece = @pieces[piece].next
      end
      entry.joined_start = start
      entry.joined_size = @joined.length - start
      entry.pieces_first = NO_NODE
      entry.pieces_last = NO_NODE
      @nodes[node] = entry
    end
    stored_data(node)
  end

  # The data as of the last join: a range of `@joined` once there is one.
  private def stored_data(node : Int32) : String
    entry = @nodes[node]
    return @datas[node] if entry.joined_start < 0
    @joined.finish[entry.joined_start, entry.joined_size]
  end

  def public_id(node : Int32) : String
    @datas[node]
  end

  def system_id(node : Int32) : String
    @system_ids[node]
  end

  # --- changing the tree ------------------------------------------------

  # *node* out of its parent's children.
  def detach(node : Int32) : Nil
    entry = @nodes[node]
    parent = entry.parent
    return if parent == NO_NODE
    if entry.previous != NO_NODE
      sibling = @nodes[entry.previous]
      sibling.next = entry.next
      @nodes[entry.previous] = sibling
    else
      owner = @nodes[parent]
      owner.first_child = entry.next
      @nodes[parent] = owner
    end
    if entry.next != NO_NODE
      sibling = @nodes[entry.next]
      sibling.previous = entry.previous
      @nodes[entry.next] = sibling
    else
      owner = @nodes[parent]
      owner.last_child = entry.previous
      @nodes[parent] = owner
    end
    entry.parent = NO_NODE
    entry.previous = NO_NODE
    entry.next = NO_NODE
    @nodes[node] = entry
  end

  # *child* as *parent*'s last child, out of wherever it was.
  def append(parent : Int32, child : Int32) : Nil
    detach(child)
    owner = @nodes[parent]
    last = owner.last_child
    entry = @nodes[child]
    entry.parent = parent
    entry.previous = last
    entry.next = NO_NODE
    @nodes[child] = entry
    if last == NO_NODE
      owner.first_child = child
    else
      sibling = @nodes[last]
      sibling.next = child
      @nodes[last] = sibling
    end
    owner.last_child = child
    @nodes[parent] = owner
  end

  # *child* just before *sibling*, out of wherever it was.
  def insert_before(sibling : Int32, child : Int32) : Nil
    detach(child)
    after = @nodes[sibling]
    parent = after.parent
    before = after.previous
    entry = @nodes[child]
    entry.parent = parent
    entry.previous = before
    entry.next = sibling
    @nodes[child] = entry
    after.previous = child
    @nodes[sibling] = after
    if before == NO_NODE
      owner = @nodes[parent]
      owner.first_child = child
      @nodes[parent] = owner
    else
      previous = @nodes[before]
      previous.next = child
      @nodes[before] = previous
    end
  end

  # *text* as *parent*'s last child: joined to it when that is text.
  def append_text(parent : Int32, text : String) : Nil
    last = @nodes[parent].last_child
    if last != NO_NODE && text?(last)
      join_text(last, text)
    else
      append(parent, create_text(text))
    end
  end

  # *text* just before *sibling*: joined to the text before it, if any.
  def insert_text_before(sibling : Int32, text : String) : Nil
    before = @nodes[sibling].previous
    if before != NO_NODE && text?(before)
      join_text(before, text)
    else
      insert_before(sibling, create_text(text))
    end
  end

  private def join_text(node : Int32, text : String) : Nil
    return if text.empty?
    entry = @nodes[node]
    if entry.joined_start < 0 && @datas[node].empty? &&
       entry.pieces_first == NO_NODE
      @datas[node] = text
      return
    end
    @pieces << Piece.new(text)
    piece = @pieces.size - 1
    if entry.pieces_last == NO_NODE
      entry.pieces_first = piece
    else
      last = @pieces[entry.pieces_last]
      last.next = piece
      @pieces[entry.pieces_last] = last
    end
    entry.pieces_last = piece
    @nodes[node] = entry
  end

  # *node*'s children appended to *new_parent*'s, in order, as nodes:
  # text is not joined to text already there.
  def reparent_children(node : Int32, new_parent : Int32) : Nil
    child = @nodes[node].first_child
    while child != NO_NODE
      following = @nodes[child].next
      append(new_parent, child)
      child = following
    end
  end

  # The attribute at *index* once more at the end of `attrs`.
  private def push_attr_copy(index : Int32) : Nil
    attr = @attrs[index]
    @attrs << Attr.new(attr.name, attr.value, attr.prefix, attr.namespace)
  end

  # *attr* among *node*'s attributes: in place of its *index*th, or after
  # them all when *index* is past them. The node gets a new range, so a
  # range other nodes share stays as it was.
  def put_attr(node : Int32, index : Int32, attr : Attr) : Nil
    entry = @nodes[node]
    start = @attrs.size
    i = 0
    while i < entry.attrs_count
      if i == index
        @attrs << attr
      else
        push_attr_copy(entry.attrs_start + i)
      end
      i = i + 1
    end
    count = entry.attrs_count
    if index >= count
      @attrs << attr
      count = count + 1
    end
    entry.attrs_start = start
    entry.attrs_count = count
    @nodes[node] = entry
  end

  # *node*'s attributes: the `count` from `start` in `attrs`.
  def set_attrs(node : Int32, start : Int32, count : Int32) : Nil
    entry = @nodes[node]
    entry.attrs_start = start
    entry.attrs_count = count
    @nodes[node] = entry
  end

  # *node* without its *index*th attribute.
  def delete_attr(node : Int32, index : Int32) : Nil
    entry = @nodes[node]
    start = @attrs.size
    i = 0
    while i < entry.attrs_count
      push_attr_copy(entry.attrs_start + i) unless i == index
      i = i + 1
    end
    entry.attrs_start = start
    entry.attrs_count = entry.attrs_count - 1
    @nodes[node] = entry
  end

  # The text of *node*'s text descendants in document order, or its own
  # data for a text or comment (libxml2's `xmlNodeGetContent`).
  def text_content(node : Int32, writer : String::Builder) : Nil
    kind = @nodes[node].kind
    if kind == NodeKind::Text || kind == NodeKind::Comment
      writer << data(node)
      return
    end
    current = @nodes[node].first_child
    return if current == NO_NODE
    # Along the links, not by recursion: the input decides the depth.
    while true
      writer << data(current) if text?(current)
      inside = element?(current) ? @nodes[current].first_child : NO_NODE
      if inside != NO_NODE
        current = inside
        next
      end
      while @nodes[current].next == NO_NODE
        current = @nodes[current].parent
        return if current == node
      end
      current = @nodes[current].next
    end
  end

  # A copy of the whole tree, nodes at the same indexes, that changes to
  # either leave the other as it is.
  def duplicate : Dom
    copy = Dom.new(Array(Attr).new(@attrs.size + 4), @empty)
    copy.copy_from(self)
    copy
  end

  protected def copy_from(other : Dom) : Nil
    @nodes.pop # the document node `initialize` made; *other*'s takes its place
    @names.pop
    @datas.pop
    @system_ids.pop
    other.nodes.each { |node| @nodes << node }
    other.names.each { |name| @names << name }
    other.datas.each { |data| @datas << data }
    other.system_ids.each { |system_id| @system_ids << system_id }
    other.attrs.each { |attr| @attrs << attr }
    other.pieces.each { |piece| @pieces << piece }
    @joined.append(other.joined_text)
  end

  protected def joined_text : String
    @joined.finish
  end

  protected def pieces : Array(Piece)
    @pieces
  end

  protected def names : Array(String)
    @names
  end

  protected def datas : Array(String)
    @datas
  end

  protected def system_ids : Array(String)
    @system_ids
  end

  # The attributes of the `count` from `start` that *node* has no
  # attribute of the same name for, added to its own.
  def add_attrs_if_missing(node : Int32, start : Int32, count : Int32) : Nil
    entry = @nodes[node]
    added = 0
    i = 0
    while i < count
      candidate = @attrs[start + i]
      found = false
      j = 0
      while j < entry.attrs_count
        existing = @attrs[entry.attrs_start + j]
        if existing.name == candidate.name && existing.namespace == candidate.namespace
          found = true
          break
        end
        j = j + 1
      end
      added = added + 1 unless found
      i = i + 1
    end
    return if added == 0
    new_start = @attrs.size
    j = 0
    while j < entry.attrs_count
      push_attr_copy(entry.attrs_start + j)
      j = j + 1
    end
    i = 0
    while i < count
      candidate = @attrs[start + i]
      found = false
      j = 0
      while j < entry.attrs_count
        existing = @attrs[entry.attrs_start + j]
        if existing.name == candidate.name && existing.namespace == candidate.namespace
          found = true
          break
        end
        j = j + 1
      end
      @attrs << candidate unless found
      i = i + 1
    end
    entry.attrs_start = new_start
    entry.attrs_count = entry.attrs_count + added
    @nodes[node] = entry
  end
end
