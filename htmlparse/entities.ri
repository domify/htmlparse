# The named character references the tokenizer looks up, as html5ever
# does: every name, and every prefix of one, is a key, so a reference is
# read a character at a time for as long as what it has read is a key.
module htmlparse/entities

import std/text
import std/int
import htmlparse/entity_data::{ENTITY_DATA}

# What `lookup` answers for a key that is only a prefix of a name.
pub PREFIX = 0_i64

# Open addressing over the keys' bytes, FNV-1a, so a name on the tape is
# looked up without a copy of it.
class Table
  @keys : Array(String)
  @values : Array(Int64)
  @mask : Int32

  def initialize(data : String)
    @mask = 16383
    @keys = Array(String).new(@mask + 1, "")
    @values = Array(Int64).new(@mask + 1, -1_i64)
    data.each_line do |line|
      parts = line.strip.split(' ')
      next unless parts.size == 3
      name = parts[0]
      value = (parts[1].to_i64 << 32) | parts[2].to_i64
      i = 1
      while i < name.bytesize
        insert(name[0, i], PREFIX, false)
        i = i + 1
      end
      insert(name, value, true)
    end
  end

  private def insert(key : String, value : Int64, replace : Bool) : Nil
    slot = (hash(Tape::String.view(key)) & @mask).to_i32
    while true
      if @values[slot] < 0
        @keys[slot] = key
        @values[slot] = value
        return
      end
      if @keys[slot] == key
        @values[slot] = value if replace
        return
      end
      slot = (slot + 1) & @mask
    end
  end

  def hash(key : Tape::String) : UInt32
    h = 2166136261_u32
    key.each_byte { |b| h = (h ^ b.to_u32) &* 16777619_u32 }
    h
  end

  def lookup(key : Tape::String) : Int64?
    slot = (hash(key) & @mask).to_i32
    while true
      value = @values[slot]
      return nil if value < 0
      return value if key == @keys[slot]
      slot = (slot + 1) & @mask
    end
    nil
  end
end

TABLE = Table.new(ENTITY_DATA)

# The code points *name* (without its `&`) stands for, as
# `first << 32 | second` with a second of 0 when there is one; `PREFIX`
# when it begins a longer name only; nil when it begins none.
pub def lookup(name : Tape::String) : Int64?
  TABLE.lookup(name)
end
