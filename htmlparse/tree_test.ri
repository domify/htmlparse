# html5lib-tests' tree construction cases, held to what html5ever 0.35
# makes of them (spec/golden/tree.jsonl, written by oracle/): the tree as
# html5lib-tests dumps one, and as html5ever's serializer writes it.
module htmlparse/tree_test

import std/text
import std/int
import std/file::{File}
import std/json::{JSON, Any}
import htmlparse/parse::{parse_document, parse_fragment, Options, Document}
import htmlparse/dom::{Dom, NodeKind, Namespace}
import htmlparse/serialize::{serialize_children, SerializeOptions}

def dump(dom : Dom, node : Int32, depth : Int32, w : Tape::String::Writer) : Nil
  indent = "  " * depth
  case dom.kind(node)
  when NodeKind::Doctype
    w << "| " << indent << "<!DOCTYPE " << dom.name(node)
    if !dom.public_id(node).empty? || !dom.system_id(node).empty?
      w << " \"" << dom.public_id(node) << "\" \"" << dom.system_id(node) << "\""
    end
    w << ">\n"
  when NodeKind::Comment
    w << "| " << indent << "<!-- " << dom.data(node) << " -->\n"
  when NodeKind::Text
    w << "| " << indent << "\"" << dom.data(node) << "\"\n"
  when NodeKind::Element
    prefix = case dom.namespace(node)
             when Namespace::Svg    then "svg "
             when Namespace::MathML then "math "
             else                        ""
             end
    w << "| " << indent << "<" << prefix << dom.name(node) << ">\n"
    lines = [] of String
    i = 0
    while i < dom.attrs_count(node)
      attr = dom.attr(node, i)
      ns = case attr.namespace
           when 4_u8 then "xlink "
           when 5_u8 then "xml "
           when 6_u8 then "xmlns "
           else           ""
           end
      lines << "#{ns}#{attr.name.to_heap}=\"#{attr.value.to_heap}\""
      i = i + 1
    end
    lines.sorted.each { |line| w << "| " << indent << "  " << line << "\n" }
    contents = dom.contents(node)
    if contents >= 0
      w << "| " << indent << "  content\n"
      child = dom.first_child(contents)
      while child >= 0
        dump(dom, child, depth + 2, w)
        child = dom.next_sibling(child)
      end
    end
  end
  child = dom.first_child(node)
  while child >= 0
    dump(dom, child, depth + 1, w)
    child = dom.next_sibling(child)
  end
end

# The tree's dump and its HTML, one after the other.
def tree(input : String, fragment : String?, scripting : Bool) : Tuple(String, String)
  result = ""
  html = ""
  tape do
    options = Options.new(scripting: scripting)
    if context = fragment
      namespace = Namespace::Html
      name = context
      if context.starts_with?("svg ")
        namespace = Namespace::Svg
        name = context[4, context.size - 4]
      elsif context.starts_with?("math ")
        namespace = Namespace::MathML
        name = context[5, context.size - 5]
      end
      document = parse_fragment(input.as_tape, name.as_tape, namespace, options)
    else
      document = parse_document(input.as_tape, options)
    end
    dom = document.dom
    w = Tape::String::Writer.new(256)
    child = dom.first_child(document.root)
    while child >= 0
      dump(dom, child, 0, w)
      child = dom.next_sibling(child)
    end
    result = w.finish.to_heap
    h = Tape::String::Writer.new(256)
    serialize_children(dom, document.root, h, SerializeOptions.new(raw_noscript: scripting))
    html = h.finish.to_heap
  end
  {result, html}
end

failures = 0
cases = 0
only = Program.args.size > 0 ? Program.args[0] : nil
File.read("spec/golden/tree.jsonl").each_line do |line|
  next if line.empty?
  test = JSON.parse(line)
  label = "#{test["file"].as_s}##{test["index"].as_i}"
  next if only && only != label
  cases = cases + 1
  got, html = tree(test["input"].as_s, test["fragment"].as_s?, test["scripting"].as_bool)
  if html != test["html"].as_s
    failures = failures + 1
    if failures <= 15 || only
      puts "FAIL #{label} (serialized)"
      puts "  input: #{test["input"].as_s.inspect}"
      puts "  expected: #{test["html"].as_s.inspect}"
      puts "  got:      #{html.inspect}"
    end
  elsif got != test["output"].as_s
    failures = failures + 1
    if failures <= 15 || only
      puts "FAIL #{label}"
      puts "  input: #{test["input"].as_s.inspect}#{test["fragment"].as_s? ? " in " + test["fragment"].as_s : ""}"
      puts "  expected:\n#{test["output"].as_s}"
      puts "  got:\n#{got}"
    end
  end
end
puts "tree: #{cases - failures}/#{cases} as html5ever"
exit 1 if failures > 0
